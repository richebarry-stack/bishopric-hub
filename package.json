{
  "name": "bishopric-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm test && node tools/check-scrollbars.mjs && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json && tsc -p workers/mailer/tsconfig.json",
    "test": "node --import ./tools/ts-resolve.mjs --test \"tests/*.test.ts\"",
    "check:scroll": "node tools/check-scrollbars.mjs",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler pages deploy dist --branch main && npm run deploy:mailer",
    "deploy:demo": "npm run build && bash deploy-demo.sh",
    "deploy:mailer": "wrangler deploy --config workers/mailer/wrangler.jsonc",
    "migrate": "wrangler d1 migrations apply bishopric-hub-db --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260617.1": true
  }
}
