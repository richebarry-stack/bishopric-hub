{
  "name": "bishopric-hub-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_DATABASE_NAME",
      "database_id": "YOUR_DATABASE_ID"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "HUB_BASE_URL": "YOUR_HUB_BASE_URL",
    "FROM_ADDRESS": "YOUR_FROM_ADDRESS",
    "FROM_NAME": "Bishopric Hub",
    // "seed" computes and records the notification ledger without sending mail —
    // use this on first deploy so the entire existing backlog doesn't email at once.
    // Flip to "live" once the ledger has been checked. If you deploy via CI (see
    // .github/workflows/deploy.yml), this is driven by the MAILER_MODE repo variable
    // instead — it always defaults to "seed" until you explicitly set that variable
    // to "live", so a fresh fork can never accidentally email anyone's real backlog.
    "MAILER_MODE": "YOUR_MAILER_MODE"
  }
}
